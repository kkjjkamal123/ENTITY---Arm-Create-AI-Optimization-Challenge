<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/monoBg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:background="@drawable/btn_outline"
                android:textColor="@color/tc_outline"
                android:text="&lt;"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/bench_title"
                android:textColor="?attr/monoFg"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Config -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                android:id="@+id/bench_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/monoFg"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle"
                tools:text="Llama-3.2-1B-Instruct-Q4_0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/bench_runs_label"
                android:textColor="?attr/monoFg"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/runs_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="1" />

                <TextView
                    android:id="@+id/runs_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="3" />

                <TextView
                    android:id="@+id/runs_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="5" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_run"
                style="@style/Entity.Button"
                android:layout_marginTop="14dp"
                android:text="@string/bench_run" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/bench_duration_label"
                android:textColor="?attr/monoFg"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/dur_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="2" />

                <TextView
                    android:id="@+id/dur_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="5" />

                <TextView
                    android:id="@+id/dur_10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="10" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_run_sustained"
                style="@style/Entity.ButtonOutline"
                android:layout_marginTop="10dp"
                android:text="@string/bench_sustained" />

            <TextView
                android:id="@+id/btn_history"
                style="@style/Entity.ButtonOutline"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="@string/bench_history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/bench_workload"
                android:textColor="?attr/monoFg"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Intro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashed"
            android:padding="12dp"
            android:textColor="?attr/monoFg"
            android:textSize="10sp"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/bench_intro" />

        <!-- Live status -->
        <LinearLayout
            android:id="@+id/bench_running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Entity.Label"
                android:text="RUNNING" />

            <TextView
                android:id="@+id/bench_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/monoFg"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.4"
                tools:text="Optimized run — performance cores" />

            <ProgressBar
                android:id="@+id/bench_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="10dp"
                android:indeterminateTint="?attr/monoFg"
                android:indeterminate="true" />
        </LinearLayout>

        <!-- Results -->
        <LinearLayout
            android:id="@+id/bench_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Entity.Label"
                android:text="RESULT" />

            <TextView
                android:id="@+id/bench_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/monoFg"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.25"
                tools:text="Big-core optimization: decode +96% faster" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/bench_table"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_inner"
                    android:padding="4dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/bench_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/monoFg"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.4"
                tools:text="Synthetic PP 512 / TG 128 run" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/bench_copy"
                    style="@style/Entity.ButtonOutline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/bench_copy" />

                <TextView
                    android:id="@+id/bench_export"
                    style="@style/Entity.ButtonOutline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/bench_export" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
