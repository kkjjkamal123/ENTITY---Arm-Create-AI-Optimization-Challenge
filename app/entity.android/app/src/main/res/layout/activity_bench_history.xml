<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:background="@drawable/btn_outline"
                android:textColor="@color/tc_outline"
                android:text="&lt;"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/history_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/history_title"
                android:textColor="@color/mono_fg"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/history_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mono_fg"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LIST MODE -->

        <TextView
            android:id="@+id/history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dashed"
            android:padding="20dp"
            android:gravity="center"
            android:text="@string/history_empty"
            android:textColor="@color/mono_fg"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.5"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/history_clear"
            style="@style/Entity.ButtonOutline"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:text="@string/history_clear"
            android:visibility="gone" />

        <!-- DETAIL MODE -->

        <LinearLayout
            android:id="@+id/detail_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_box"
                android:padding="16dp">

                <TextView
                    android:id="@+id/detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mono_fg"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.35" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/mono_fg"
                        android:textSize="10.5sp"
                        android:lineSpacingMultiplier="1.3"
                        android:textIsSelectable="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/detail_copy"
                    style="@style/Entity.ButtonOutline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:text="@string/bench_copy" />

                <TextView
                    android:id="@+id/detail_export"
                    style="@style/Entity.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:text="@string/bench_export" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_delete"
                style="@style/Entity.ButtonOutline"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="@string/history_delete" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
