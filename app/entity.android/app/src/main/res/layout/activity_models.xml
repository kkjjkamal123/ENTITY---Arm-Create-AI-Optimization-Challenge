<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/monoBg"
   >

    <!-- Header stays put while the lists scroll, so the back button is always reachable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:background="@drawable/btn_outline"
            android:textColor="@color/tc_outline"
            android:text="&lt;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/models_title"
            android:textColor="?attr/monoFg"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Download progress: only visible while a transfer is running -->
    <LinearLayout
        android:id="@+id/dl_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_box"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dl_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/monoFg"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Qwen2.5 0.5B Instruct  42%" />

        <ProgressBar
            android:id="@+id/dl_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_mono" />

        <TextView
            android:id="@+id/dl_cancel"
            style="@style/Entity.ButtonOutline"
            android:layout_marginTop="10dp"
            android:textSize="11sp"
            android:text="@string/model_download_stop" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- ON THIS PHONE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Entity.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/models_installed" />

                <TextView
                    android:id="@+id/installed_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/monoFg"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    tools:text="2 · 1.55 GB" />
            </LinearLayout>

            <TextView
                android:id="@+id/installed_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dashed"
                android:padding="18dp"
                android:gravity="center"
                android:text="@string/models_installed_empty"
                android:textColor="?attr/monoFg"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.5"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/installed_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/btn_import"
                style="@style/Entity.ButtonOutline"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:text="@string/model_import" />

            <!-- RECOMMENDED FOR THIS PHONE -->
            <!--
              Driven by DeviceProbe: a sub-second bandwidth and integer-throughput
              measurement that needs no model downloaded. Decode is bandwidth-bound and
              prefill is compute-bound, so both can be predicted before committing to a
              multi-gigabyte transfer.
            -->

            <TextView
                style="@style/Entity.Label"
                android:layout_marginTop="22dp"
                android:text="@string/models_recommended" />

            <LinearLayout
                android:id="@+id/probe_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_box">

                <TextView
                    android:id="@+id/probe_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/monoFg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/probe_idle" />

                <TextView
                    android:id="@+id/probe_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/monoDim"
                    android:textSize="10sp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/probe_idle_note" />

                <TextView
                    android:id="@+id/probe_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:textColor="?attr/monoDim"
                    android:textSize="10sp"
                    android:lineSpacingMultiplier="1.4" />

                <!--
                    Entity.Button carries no horizontal padding because every other button in
                    the app is match_parent, where centred text never reaches the border. This
                    one is wrap_content, so the background shrinks to the text and the padding
                    has to be supplied here. paddingEnd is larger than paddingStart on purpose:
                    letterSpacing appends a trailing gap after the final glyph, which visually
                    shifts centred text left unless the right side is given more room.
                -->
                <TextView
                    android:id="@+id/probe_run"
                    style="@style/Entity.Button"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:textSize="11sp"
                    android:text="@string/probe_run" />
            </LinearLayout>

            <!-- AVAILABLE TO DOWNLOAD -->

            <TextView
                style="@style/Entity.Label"
                android:layout_marginTop="22dp"
                android:text="@string/models_catalog" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:text="@string/models_catalog_note"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.4" />

            <LinearLayout
                android:id="@+id/catalog_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
