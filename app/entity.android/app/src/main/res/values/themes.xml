<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.AiChatSample" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="colorSurface">@color/app_bg</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.AiChatSample" parent="Base.Theme.AiChatSample" />

    <style name="SettingLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="SettingSeek">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
