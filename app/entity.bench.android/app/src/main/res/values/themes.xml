<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EntityBench" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mono_fg</item>
        <item name="colorOnPrimary">@color/mono_bg</item>
        <item name="android:colorBackground">@color/mono_bg</item>
        <item name="colorSurface">@color/mono_bg</item>
        <item name="colorOnSurface">@color/mono_fg</item>
        <item name="android:textColorPrimary">@color/mono_fg</item>
        <item name="android:textColorSecondary">@color/mono_fg</item>
        <item name="android:textColor">@color/mono_fg</item>
        <item name="android:textColorHint">@color/mono_fg</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:statusBarColor">@color/mono_bg</item>
        <item name="android:navigationBarColor">@color/mono_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="alertDialogTheme">@style/Dialog.EntityBench</item>
    </style>

    <!-- Dialogs follow the same two-color rule: square, bordered, monospace. -->
    <style name="Dialog.EntityBench" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorPrimary">@color/mono_fg</item>
        <item name="colorAccent">@color/mono_fg</item>
        <item name="android:textColor">@color/mono_fg</item>
        <item name="android:textColorPrimary">@color/mono_fg</item>
        <item name="android:textColorSecondary">@color/mono_fg</item>
        <item name="android:textColorAlertDialogListItem">@color/mono_fg</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:colorBackground">@color/mono_bg</item>
        <!-- Force ink text on the OK/Cancel/etc. buttons; without this the button
             color can resolve from the base dialog theme and vanish into the bg. -->
        <item name="buttonBarButtonStyle">@style/Dialog.EntityBench.Button</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dialog.EntityBench.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dialog.EntityBench.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Dialog.EntityBench.Button</item>
    </style>

    <style name="Dialog.EntityBench.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/mono_fg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Section label: the only uppercase element, always over the border line. -->
    <style name="Bench.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/mono_fg</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Inverted block button (primary action). -->
    <style name="Bench.Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/btn_solid</item>
        <item name="android:textColor">@color/tc_solid</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Bordered button (secondary action). Inverts while pressed. -->
    <style name="Bench.ButtonOutline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/tc_outline</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>
</resources>
