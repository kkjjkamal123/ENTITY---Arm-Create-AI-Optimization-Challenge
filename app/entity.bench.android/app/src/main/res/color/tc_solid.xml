<?xml version="1.0" encoding="utf-8"?>
<!-- Text on a filled surface. Pressed inverts to an outlined box, so text returns to fg. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="?attr/monoFg" />
    <item android:state_enabled="false" android:color="?attr/monoDim" />
    <item android:color="?attr/monoOnFill" />
</selector>
