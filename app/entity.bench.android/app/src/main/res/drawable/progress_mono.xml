<?xml version="1.0" encoding="utf-8"?>
<!-- Determinate progress: outlined track, solid fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:drawable="@drawable/bg_inner" />
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="?attr/monoFill" />
                <corners android:radius="@dimen/mono_radius" />
            </shape>
        </clip>
    </item>
</layer-list>
