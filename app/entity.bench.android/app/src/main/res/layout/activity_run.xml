<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/run_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/run_title"
            android:textColor="@color/mono_fg"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/run_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mono_fg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/run_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/mono_fg"
        android:textSize="11sp" />

    <!-- Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_box"
        android:padding="16dp">

        <TextView
            android:id="@+id/run_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mono_fg"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:minLines="2" />

        <!-- Blocky progress: a bordered track with a hard fill, no Material bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_inner"
            android:padding="3dp">

            <View
                android:id="@+id/progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="@drawable/bg_fill" />

            <View
                android:id="@+id/progress_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/progress_pct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:textColor="@color/mono_fg"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live telemetry -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_box"
        android:padding="16dp">

        <TextView
            style="@style/Bench.Label"
            android:text="@string/live_label" />

        <GridLayout
            android:id="@+id/live_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dashed"
        android:padding="12dp"
        android:text="@string/run_keep_on"
        android:textColor="@color/mono_fg"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btn_abort"
        style="@style/Bench.ButtonOutline"
        android:layout_marginBottom="6dp"
        android:text="@string/run_cancel" />
</LinearLayout>
