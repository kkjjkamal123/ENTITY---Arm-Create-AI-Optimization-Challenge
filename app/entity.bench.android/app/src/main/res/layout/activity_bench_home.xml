<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bench_bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@mipmap/ic_entity_black"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bench_home_title"
                    android:textColor="@color/bench_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bench_home_sub"
                    android:textColor="@color/bench_muted"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/home_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="@string/menu_settings"
                app:tint="@color/bench_sub" />
        </LinearLayout>

        <!-- Device under test -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bench_card"
            android:padding="17dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dot_live"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_bench_dot" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/bench_dut"
                    android:textColor="@color/bench_accent"
                    android:textSize="11sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/dut_power_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="10.5sp"
                    android:textColor="@color/bench_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/dut_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="monospace"
                android:textColor="@color/bench_text"
                android:textSize="16sp" />

            <GridLayout
                android:id="@+id/dut_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2" />
        </LinearLayout>

        <!-- New run -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_bench_card"
            android:padding="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bench_new_run"
                android:textColor="@color/bench_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/row_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_bench_inner"
                android:foreground="?attr/selectableItemBackground"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bench_model_label"
                        android:textColor="@color/bench_muted"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/model_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/bench_text"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/bench_model_none" />
                </LinearLayout>

                <TextView
                    android:id="@+id/model_kleidi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:textColor="@color/bench_accent"
                    android:background="@drawable/bg_bench_inner"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/bench_chevron"
                    android:textColor="@color/bench_faint"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/bench_runs_config"
                android:textColor="@color/bench_muted"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/runs_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:text="@string/bench_runs_1" />

                <TextView
                    android:id="@+id/runs_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:text="@string/bench_runs_3" />

                <TextView
                    android:id="@+id/runs_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:text="@string/bench_runs_5" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="@color/bench_text2"
                    android:background="@drawable/bg_bench_inner"
                    android:text="@string/bench_workload" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/arms_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/btn_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_bench_run"
                android:foreground="?attr/selectableItemBackground"
                android:textColor="@color/bench_on_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/bench_run_cta" />

            <TextView
                android:id="@+id/run_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/bench_muted"
                android:textSize="10.5sp"
                android:text="@string/bench_run_note" />
        </LinearLayout>

        <!-- Last result -->
        <LinearLayout
            android:id="@+id/card_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_bench_card"
            android:padding="17dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bench_last_result"
                    android:textColor="@color/bench_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/bench_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/result_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/bench_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/bench_sub"
                android:textSize="11.5sp"
                android:lineSpacingMultiplier="1.4" />

            <LinearLayout
                android:id="@+id/result_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/btn_open_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:paddingVertical="11dp"
                android:background="@drawable/bg_bench_outline"
                android:foreground="?attr/selectableItemBackground"
                android:textColor="@color/bench_accent"
                android:textSize="13.5sp"
                android:text="@string/bench_open_results" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/card_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bench_history"
                android:textColor="@color/bench_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:fontFamily="monospace"
            android:textColor="@color/bench_faint"
            android:textSize="10sp"
            android:text="@string/bench_footer" />
    </LinearLayout>
</ScrollView>
