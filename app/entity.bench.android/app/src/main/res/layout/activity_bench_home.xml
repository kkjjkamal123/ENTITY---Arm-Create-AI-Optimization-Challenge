<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/bench_mark"
                android:contentDescription="@string/app_name"
                app:tint="@color/mono_fg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_title"
                    android:textColor="@color/mono_fg"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_sub"
                    android:textColor="@color/mono_fg"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_outline"
                android:textColor="@color/tc_outline"
                android:text="@string/home_settings"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp" />
        </LinearLayout>

        <!-- Device under test -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Bench.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/dut_label" />

                <TextView
                    android:id="@+id/dut_power_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mono_fg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/dut_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/mono_fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/dut_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2" />
        </LinearLayout>

        <!-- Run configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                style="@style/Bench.Label"
                android:text="@string/cfg_label" />

            <LinearLayout
                android:id="@+id/row_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_outline"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/model_label"
                        android:textColor="@color/mono_fg"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18" />

                    <TextView
                        android:id="@+id/model_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/mono_fg"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:text="@string/model_none" />
                </LinearLayout>

                <TextView
                    android:id="@+id/model_kleidi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/mono_bg"
                    android:background="@drawable/bg_fill"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="&gt;"
                    android:textColor="@color/mono_fg"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/mode_ablation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/mode_ablation" />

                <TextView
                    android:id="@+id/mode_sustained"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/mode_sustained" />

                <TextView
                    android:id="@+id/mode_sweep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/mode_sweep" />
            </LinearLayout>

            <!-- Ablation config -->
            <LinearLayout
                android:id="@+id/group_ablation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/runs_label"
                    android:textColor="@color/mono_fg"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/runs_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="1" />

                    <TextView
                        android:id="@+id/runs_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="3" />

                    <TextView
                        android:id="@+id/runs_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="5" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_eff_arm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="2dp">

                    <View
                        android:id="@+id/eff_arm_box"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_inner" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/efficiency_arm"
                        android:textColor="@color/mono_fg"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sustained config -->
            <LinearLayout
                android:id="@+id/group_sustained"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/duration_label"
                    android:textColor="@color/mono_fg"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/dur_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="2" />

                    <TextView
                        android:id="@+id/dur_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="5" />

                    <TextView
                        android:id="@+id/dur_10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="10" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/workload_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/workload"
                android:textColor="@color/mono_fg"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btn_run"
                style="@style/Bench.Button"
                android:layout_marginTop="14dp"
                android:text="@string/run_cta" />
        </LinearLayout>

        <!-- Last result -->
        <LinearLayout
            android:id="@+id/card_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Bench.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/last_result" />

                <TextView
                    android:id="@+id/result_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mono_fg"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/result_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/mono_fg"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mono_fg"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.4" />

            <LinearLayout
                android:id="@+id/result_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/btn_open_result"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="14dp"
                android:text="@string/open_full_results" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/card_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Bench.Label"
                android:text="@string/history_label" />

            <LinearLayout
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/btn_all_results"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="6dp"
                android:text="@string/history_all" />
        </LinearLayout>

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="6dp"
            android:textColor="@color/mono_fg"
            android:textSize="10sp"
            android:text="@string/home_footer" />
    </LinearLayout>
</ScrollView>
