<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/monoBg">

    <!-- Header stays put; the list scrolls under it -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:background="@drawable/btn_outline"
            android:textColor="@color/tc_outline"
            android:text="&lt;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/contribute_title"
            android:textColor="?attr/monoFg"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.45"
                android:text="@string/contribute_pick_body" />

            <!-- Select all / none -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/btn_select_all"
                    style="@style/Bench.ButtonOutline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:text="@string/contribute_select_all" />

                <TextView
                    android:id="@+id/btn_select_unsent"
                    style="@style/Bench.ButtonOutline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:text="@string/contribute_select_unsent" />
            </LinearLayout>

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dashed"
                android:padding="20dp"
                android:gravity="center"
                android:text="@string/contribute_empty"
                android:textColor="?attr/monoFg"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.5"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/result_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Send bar pinned to the bottom, so the action is reachable from any scroll position -->
    <LinearLayout
        android:id="@+id/send_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/send_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/monoDim"
            android:textSize="10sp"
            android:fontFamily="monospace"
            tools:text="2 selected · 1 already sent" />

        <TextView
            android:id="@+id/btn_send"
            style="@style/Bench.Button"
            android:textSize="12sp"
            android:text="@string/contribute_send" />
    </LinearLayout>
</LinearLayout>
