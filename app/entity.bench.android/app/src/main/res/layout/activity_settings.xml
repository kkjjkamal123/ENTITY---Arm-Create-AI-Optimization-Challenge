<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/monoBg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:background="@drawable/btn_outline"
                android:textColor="@color/tc_outline"
                android:text="&lt;"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/settings_title"
                android:textColor="?attr/monoFg"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Theme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                style="@style/Bench.Label"
                android:text="@string/theme_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/theme_system"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/theme_system" />

                <TextView
                    android:id="@+id/theme_light"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/theme_light" />

                <TextView
                    android:id="@+id/theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/theme_dark" />
            </LinearLayout>

            <TextView
                style="@style/Bench.Label"
                android:layout_marginTop="18dp"
                android:text="@string/palette_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/palette_mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/palette_mono" />

                <TextView
                    android:id="@+id/palette_colour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:text="@string/palette_colour" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/palette_note" />
        </LinearLayout>

        <!-- Benchmark -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                style="@style/Bench.Label"
                android:text="@string/sec_benchmark" />

            <TextView
                android:id="@+id/row_keep_on"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="12dp"
                android:textSize="11sp"
                android:text="@string/settings_keep_on" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/settings_keep_on_desc" />

            <TextView
                android:id="@+id/row_eff_arm_set"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="12dp"
                android:textSize="11sp"
                android:text="@string/settings_eff_arm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/settings_eff_arm_desc" />
        </LinearLayout>

        <!-- Data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                style="@style/Bench.Label"
                android:text="@string/sec_data" />

            <TextView
                android:id="@+id/row_models"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="12dp"
                android:textSize="11sp"
                android:text="@string/settings_models" />

            <TextView
                android:id="@+id/models_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/row_results"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="12dp"
                android:textSize="11sp"
                android:text="@string/settings_results" />

            <TextView
                android:id="@+id/results_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Contribute -->
        <LinearLayout
            android:id="@+id/card_contribute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                style="@style/Bench.Label"
                android:text="@string/sec_contribute" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.45"
                android:text="@string/contribute_body" />

            <!-- The on/off control: a checkbox row, not a fourth outline button, so it
                 reads as a persistent switch rather than another action to tap. -->
            <LinearLayout
                android:id="@+id/row_contribute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top">

                <View
                    android:id="@+id/contribute_check"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/bg_inner" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/monoFg"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:text="@string/contribute_toggle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/monoDim"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.35"
                        android:text="@string/contribute_toggle_desc" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/row_contribute_pick"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="16dp"
                android:textSize="11sp"
                android:text="@string/contribute_open" />

            <TextView
                android:id="@+id/row_contribute_show"
                style="@style/Bench.ButtonOutline"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="@string/contribute_show" />

            <TextView
                android:id="@+id/contribute_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/monoDim"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- About -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                style="@style/Bench.Label"
                android:text="@string/about_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/about_body"
                android:textColor="?attr/monoFg"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.5" />

            <TextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/monoFg"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
