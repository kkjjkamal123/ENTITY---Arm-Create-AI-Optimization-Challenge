<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:background="@drawable/btn_outline"
                android:textColor="@color/tc_outline"
                android:text="&lt;"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/result_title"
                android:textColor="@color/mono_fg"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/result_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mono_fg"
                android:textSize="10sp"
                android:gravity="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/result_context"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/mono_fg"
            android:textSize="11sp" />

        <!-- Headline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_box"
            android:padding="16dp">

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mono_fg"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headline_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mono_fg"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.4" />

            <LinearLayout
                android:id="@+id/result_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Table -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_box"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/table"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </HorizontalScrollView>

        <!-- Notes -->
        <TextView
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashed"
            android:padding="14dp"
            android:textColor="@color/mono_fg"
            android:textSize="10.5sp"
            android:lineSpacingMultiplier="1.5" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/btn_copy"
                style="@style/Bench.ButtonOutline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/result_copy" />

            <TextView
                android:id="@+id/btn_export"
                style="@style/Bench.Button"
                android:layout_width="0dp"
                android:layout_weight="1.4"
                android:layout_marginStart="8dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:textSize="13sp"
                android:text="@string/result_export" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_delete"
            style="@style/Bench.ButtonOutline"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:text="@string/result_delete" />
    </LinearLayout>
</ScrollView>
